# Copy to .env and fill in. Never commit .env.

# --- database (required) ---
DB_SERVER=localhost\WRLDEV
DB_PORT=1433
DB_NAME=Garuda_WRL_TEST
DB_USER=
DB_PASSWORD=

# --- secrets (required) ---
# The original site's AES key for Users.Password (same value as its Web.config), so existing passwords keep working.
PASSWORD_AES_KEY=
# Any long random string; signs the session cookie. Changing it signs everyone out.
SESSION_SECRET=

# --- app ---
PORT=4000
ERP=WRL
# business unit preselected on the sign-in page
DBU=12201
QR_SPECIAL=
# sign-in lifetime in minutes (the original: one year)
SESSION_MINUTES=525600
# the old site's ~/GuideFiles folder (station guides)
GUIDE_FILES_DIR=

# --- security / operations (all optional) ---
# Secure cookie (HTTPS only). Default: on when NODE_ENV=production. Set false while the plant serves plain HTTP.
COOKIE_SECURE=
NODE_ENV=production
# behind IIS / a reverse proxy: number of proxy hops (e.g. 1) so login limits see the real client address
TRUST_PROXY=
# failed sign-ins before a pause: per user ID (per device: 5x); window in minutes
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_MINUTES=15
# Content-Security-Policy: report (default: logs violations in the browser console), enforce, or off
CSP=report
# show "<server> <database>" under the sign-in form, as the original did
SHOW_DB_ON_LOGIN=false
# also write request / error lines to this file (blank: console only)
LOG_FILE=
