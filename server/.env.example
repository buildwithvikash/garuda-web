# Copy to .env and fill in. Never commit .env.
PORT=4000

# SQL Server (use the UAT copy for development and parity testing)
DB_SERVER=10.100.95.160
DB_PORT=1433
DB_NAME=Garuda_WRL_UAT
DB_USER=
DB_PASSWORD=

# Same meaning as the original Web.config appSettings
ERP=WRL
DBU=281
QR_SPECIAL=

# Key the original app uses to encrypt Users.Password (WrapperAvatar.encrypt). Must match exactly.
PASSWORD_AES_KEY=
# Long random string used to sign session cookies
SESSION_SECRET=
# Session lifetime in minutes (original: 525600 = 1 year)
SESSION_MINUTES=525600
